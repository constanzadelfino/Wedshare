// Modelos de la base de datos (la "M" del MVC).
// Cada modelo se convierte en una tabla al correr una migración.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Un casamiento. Lo crean los novios desde la app.
model Event {
  id              String   @id @default(uuid()) @db.Uuid
  // Usuario de Supabase Auth que creó el evento. Cada cuenta tiene un solo casamiento.
  ownerId         String   @unique @map("owner_id") @db.Uuid
  name            String
  // Solo la fecha, sin hora.
  date            DateTime @db.Date
  // Salón o dirección.
  venue           String
  // "Google Calendar: se actualiza si cambia la fecha".
  calendarSync    Boolean  @default(true) @map("calendar_sync")
  // Módulos opcionales.
  playlistEnabled Boolean  @default(true) @map("playlist_enabled")
  giftsEnabled    Boolean  @default(true) @map("gifts_enabled")

  // Personalizar → Portada.
  // Nombres de los novios como aparecen en la invitación. Ej: "[Nombre] y [Nombre]".
  coupleNames        String?  @map("couple_names")
  welcomeMessage     String?  @map("welcome_message")
  // Rutas de hasta 3 fotos en Supabase Storage, en orden.
  coverPhotos        String[] @default([]) @map("cover_photos")
  coverWithoutPhotos Boolean  @default(false) @map("cover_without_photos")

  // Personalizar → Eventos.
  rsvpDeadline DateTime? @map("rsvp_deadline") @db.Date
  dressCode    String?   @map("dress_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guestGroups GuestGroup[]
  items       EventItem[]

  @@map("events")
}

// Cada parte del casamiento: civil, ceremonia, festejo u otra que agreguen los novios.
model EventItem {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Ej: "Civil", "Ceremonia", "Festejo".
  name      String
  date      DateTime @db.Date
  // Formato HH:MM, en horario de Argentina.
  time      String
  venueName String   @map("venue_name")
  address   String
  // Datos de Google Maps, si la dirección se eligió del autocompletado.
  placeId   String?  @map("place_id")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("event_items")
}

// Una familia o grupo de invitados. Recibe un link único y confirma una sola vez.
// Si alguien va solo, es un grupo de una persona.
model GuestGroup {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Ej: "Familia Pérez".
  name        String
  // WhatsApp para mandarles el link. Opcional.
  phone       String?
  // Parte del link de la invitación. Es secreto: quien lo tiene ve la invitación del grupo.
  inviteToken String   @unique @map("invite_token")
  // Lo que lleva el QR de ingreso. Es distinto del link para que una foto del QR no abra la
  // invitación. Se crea la primera vez que alguien del grupo confirma.
  entryCode   String?  @unique @map("entry_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guests Guest[]
  rsvp   Rsvp?

  @@index([eventId])
  @@map("guest_groups")
}

// Respuesta de cada persona a la invitación.
enum GuestStatus {
  pending
  confirmed
  declined
}

// Una persona invitada, dentro de un grupo.
model Guest {
  id        String      @id @default(uuid()) @db.Uuid
  groupId   String      @map("group_id") @db.Uuid
  group     GuestGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  status    GuestStatus @default(pending)
  // Preferencia alimentaria que anota el invitado al confirmar. Ej: "vegetariano".
  dietary   String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  entryCheck EntryCheck?

  @@index([groupId])
  @@map("guests")
}

// Respuesta de un grupo a la invitación: una sola por grupo. Quién asiste queda en cada
// invitado (guests.status y guests.dietary); acá va el mensaje para los novios.
model Rsvp {
  id        String     @id @default(uuid()) @db.Uuid
  groupId   String     @unique @map("group_id") @db.Uuid
  group     GuestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message   String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("rsvps")
}

// Ingreso de una persona al casamiento, registrado al escanear el QR de su grupo.
// Cada persona entra una sola vez; si el grupo llega separado, se registra a cada uno cuando llega.
model EntryCheck {
  id        String   @id @default(uuid()) @db.Uuid
  guestId   String   @unique @map("guest_id") @db.Uuid
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("entry_checks")
}
