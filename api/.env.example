# Copiá este archivo como .env y completá los datos.
# Cadena de conexión de Supabase: Project Settings → Database → Connection string,
# opción "Session pooler" (puerto 5432). Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=

# Puerto donde corre la API.
PORT=3000

# URL del proyecto de Supabase (Project Settings → API). Se usa para verificar las sesiones.
SUPABASE_URL=

# Clave secreta de Supabase (Project Settings → API Keys → Secret key). Solo para la API:
# se usa para subir las fotos de portada. Nunca la pongas en la app.
SUPABASE_SECRET_KEY=

# Clave de Google Maps (Google Cloud → Credenciales), limitada a "Places API (New)".
# Se usa para autocompletar las direcciones. Si falta, las direcciones se escriben a mano.
GOOGLE_MAPS_API_KEY=
