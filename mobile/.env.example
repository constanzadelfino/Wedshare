# Copiá este archivo como .env y completá los datos del proyecto de Supabase
# (Project Settings → API Keys). Nunca pongas acá la clave secreta.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección de la API de Wedshare. Con Expo Go, usá la IP de tu computadora en la red Wi-Fi
# (no localhost, porque el celular no la encontraría). Ejemplo: http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=

# Dirección base de los links de invitación (web del invitado). Con Expo Go, la IP de tu computadora
# en el Wi-Fi y el puerto de la web. dev.cmd la actualiza solo. Ejemplo: http://192.168.0.10:5173/invitacion
EXPO_PUBLIC_INVITE_URL=
