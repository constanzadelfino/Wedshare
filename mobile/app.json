{
  "expo": {
    "name": "Wedshare",
    "slug": "wedshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-media-library",
        {
          "photosPermission": "Wedshare usa tus fotos para la portada de la invitación.",
          "savePhotosPermission": "Wedshare guarda en tus fotos la portada para tu playlist."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wedshare usa tus fotos para la portada de la invitación."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wedshare usa la cámara para escanear el QR de los invitados en la entrada.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "wedshare",
    "experiments": {
      "typedRoutes": true
    }
  }
}
